ENV=local
# Local only: lets the frontend sign in with the three demo accounts. Never in production.
DEMO_MODE=true

# Local Docker Postgres. On Render, use the Supabase *Session pooler* string instead.
DATABASE_URL=postgresql://brandguard:brandguard@localhost:5432/brandguard

# Comma-separated exact origins. Add the Vercel URL after the first frontend deploy.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase (used to verify JWTs in Phase 2)
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Leave empty unless your project still uses the legacy shared JWT secret (HS256).
SUPABASE_JWT_SECRET=

# AI harness
LLM_ENABLED=true
LLM_PROVIDER=openai
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
