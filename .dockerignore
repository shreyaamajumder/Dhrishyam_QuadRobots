# Version control and IDE
.git/
.gitignore
.vscode/
.idea/

# Environment files and secrets
.env
.env.*
!.env.example

# Python virtual environments & caches (crucial for zero-spillage)
.virt/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Node.js dependencies & builds (crucial: avoids copying Windows binaries to Linux)
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/

# Non-runtime assets
docs/
tests/
scripts/
*.md
!README.md
*.log
