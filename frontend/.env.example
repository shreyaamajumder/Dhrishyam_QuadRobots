# Copy to frontend/.env (never committed). Every VITE_ value ends up in the public website,
# so only public values go here: never a secret key.

# The backend. Locally http://localhost:8000; on Vercel the Render URL (no /api/v1, no trailing slash).
VITE_API_URL=http://localhost:8000

# Real sign-in (Supabase Auth). Leave both empty to use the demo accounts instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
